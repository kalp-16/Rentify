<!-- views/wishlist/index.ejs -->

<% layout("/layouts/boilerplate") %>
<h2 class="mb-4"> My Wishlist </h2>
<div class="row">
    <% wishlist.forEach(listing => { %>
    <div class="col-md-4 mb-4">
        <div class="card">
            <img src="<%= listing.image[0]?.url %>" class="card-img-top">
            <div class="card-body">
                <h5><%= listing.title %></h5>
                <p>₹<%= listing.price %></p>
                <a href="/listings/<%= listing._id %>" class="btn btn-dark"> View </a>
            </div>
        </div>
    </div>
    <% }) %>
</div>