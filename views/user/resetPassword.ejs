<% layout("/layouts/boilerplate") %>

<div class="container auth-page">
    <div class="row justify-content-center">
        <div class="col-lg-12">
            <div class="auth-card">
                <div class="text-center mb-4">
                    <h2 class="fw-bold">Reset Password</h2>
                    <p class="text-muted">
                        Create a new password for your Rentify account.
                    </p>
                </div>
                <form action="/reset-password/<%= token %>" method="POST" class="needs-validation" novalidate>
                    <!-- New Password -->
                    <div class="mb-3">
                        <label class="form-label"> New Password</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="password" name="password" minlength="8" required>
                            <button class="btn btn-outline-secondary" type="button" id="togglePassword">Show</button>
                        </div>
                        <small id="passwordStrength" class="text-muted">Minimum 8 characters</small>
                    </div>
                    <!-- Confirm Password -->
                    <div class="mb-4">
                        <label class="form-label"> Confirm Password</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="confirmPassword" required>
                            <button class="btn btn-outline-secondary" type="button" id="toggleConfirm">Show</button>
                        </div>
                        <small id="matchText"></small>
                    </div>
                    <button class="btn btn-dark auth-btn w-100" style="background-color: #fa2727; ">Update Password</button>
                </form>
                <hr>
                <div class="text-center">
                    <a href="/login">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

// ----------------------------
// Show / Hide Password
// ----------------------------

const password =
document.getElementById("password");

const confirmPassword =
document.getElementById("confirmPassword");

document
.getElementById("togglePassword")
.onclick=function(){

password.type=
password.type==="password"
?"text":"password";

this.innerHTML=
password.type==="password"
?"Show":"Hide";

};

document
.getElementById("toggleConfirm")
.onclick=function(){

confirmPassword.type=
confirmPassword.type==="password"
?"text":"password";

this.innerHTML=
confirmPassword.type==="password"
?"Show":"Hide";

};


// ----------------------------
// Password Strength
// ----------------------------

const strength =
document.getElementById("passwordStrength");

password.addEventListener("keyup",()=>{

let score=0;

if(password.value.length>=8) score++;

if(/[A-Z]/.test(password.value)) score++;

if(/[0-9]/.test(password.value)) score++;

if(/[^A-Za-z0-9]/.test(password.value)) score++;

const labels=[
"",
"Weak Password",
"Fair Password",
"Good Password",
"Strong Password"
];

const classes=[
"",
"text-danger",
"text-warning",
"text-primary",
"text-success"
];

strength.className="";

if(score>0){

strength.classList.add(classes[score]);

}

strength.innerHTML=labels[score];

});


// ----------------------------
// Password Match
// ----------------------------

const matchText=
document.getElementById("matchText");

confirmPassword.addEventListener("keyup",()=>{

if(confirmPassword.value===""){

matchText.innerHTML="";

return;

}

if(password.value===confirmPassword.value){

matchText.className="text-success";

matchText.innerHTML="✔ Passwords match";

}

else{

matchText.className="text-danger";

matchText.innerHTML="✖ Passwords do not match";

}

});


// ----------------------------
// Bootstrap Validation
// ----------------------------

(()=>{
'use strict'

const forms=
document.querySelectorAll('.needs-validation')

Array.from(forms).forEach(form=>{

form.addEventListener('submit',event=>{

if(
!form.checkValidity() ||
password.value!==confirmPassword.value
){

event.preventDefault();

event.stopPropagation();
}
form.classList.add('was-validated');
},false);
});
})();
</script>